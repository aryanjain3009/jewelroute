# --- JewelRoute API ---
NODE_ENV=development
PORT=4000
# Pooled URL for the app (Neon: the -pooler host, add ?pgbouncer=true&connection_limit=1 on Vercel)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/jewelroute
# Direct (non-pooled) URL used by `prisma migrate deploy`
DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:5432/jewelroute
# openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_SECRET=
CRON_SECRET=
# openssl rand -base64 32   (AES-256-GCM key for webhook secrets at rest)
APP_ENCRYPTION_KEY=
# Web origin (ack links / QR codes point here)
APP_PUBLIC_URL=http://localhost:3000
# Public origin of this API (webhook demo receiver URLs are built from it)
API_PUBLIC_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS (the web normally proxies /api, so this is a fallback)
CORS_ORIGINS=http://localhost:3000
# Optional: Vercel Blob read-write token → proof photos go straight from the phone to Blob
BLOB_READ_WRITE_TOKEN=
LOG_LEVEL=info
# Built-in demo webhook receiver (/v1/dev/webhook-receiver/:token): true | false.
# Unset = on outside production; in production only for endpoints of demo-mode tenants. false = always 404.
# ENABLE_DEMO_RECEIVER=true
# Proxy hops trusted for the client IP (rate limits, audit IPs). Unset → 1 on Vercel, 0 elsewhere.
# Behind exactly one reverse proxy that appends X-Forwarded-For (nginx, Docker ingress) set 1. Never more than you have.
# TRUST_PROXY=0
# Webhook SSRF guard: endpoint URLs resolving to loopback/private/link-local/metadata addresses are refused at
# create/update and at every delivery. The built-in demo receiver (API_PUBLIC_URL/v1/dev/webhook-receiver/…) is
# always allowed while enabled. 'true' disables the guard — local development and tests ONLY; ignored in production
# except for demo-mode tenants.
# WEBHOOK_ALLOW_PRIVATE=true
